# Example only. Replace every CHANGE_ME value using your hosting secret manager.
# Never deploy this template as-is or commit an actual .env file.
HOMESCOUT_ENVIRONMENT=production
HOMESCOUT_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/homescout?sslmode=require
HOMESCOUT_AUTH_SIGNING_KEY=CHANGE_ME_INJECT_RANDOM_32_BYTES_OR_MORE
HOMESCOUT_AUTH_DEV_EXPOSE_TOKENS=false
HOMESCOUT_FINANCE_ENCRYPTION_KEY=CHANGE_ME_INJECT_BASE64_32_BYTE_KEY
HOMESCOUT_TRUST_ENCRYPTION_KEY=CHANGE_ME_INJECT_DIFFERENT_BASE64_32_BYTE_KEY
HOMESCOUT_MESSAGE_ENCRYPTION_KEY=CHANGE_ME_INJECT_DIFFERENT_BASE64_32_BYTE_KEY
HOMESCOUT_AI_ENCRYPTION_KEY=CHANGE_ME_INJECT_DIFFERENT_BASE64_32_BYTE_KEY
HOMESCOUT_AI_ENABLED=false
HOMESCOUT_MPESA_ENABLED=false
HOMESCOUT_MPESA_ENVIRONMENT=production
HOMESCOUT_MPESA_SERVICE_COLLECTION_AUTHORIZED=false
HOMESCOUT_SMTP_HOST=CHANGE_ME
HOMESCOUT_SMTP_PORT=587
HOMESCOUT_SMTP_USERNAME=CHANGE_ME
HOMESCOUT_SMTP_PASSWORD=CHANGE_ME
HOMESCOUT_SMTP_FROM=CHANGE_ME
HOMESCOUT_SMTP_STARTTLS=true
HOMESCOUT_LOG_LEVEL=INFO
HOMESCOUT_CORS_ORIGINS=[]
